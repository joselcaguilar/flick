{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Flick Sightline Cue Desk",
  "color": {
    "light": {
      "background": {
        "$type": "color",
        "$value": "#F4F7F2"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "surfaceRaised": {
        "$type": "color",
        "$value": "#E7EFE8"
      },
      "text": {
        "$type": "color",
        "$value": "#13201B"
      },
      "muted": {
        "$type": "color",
        "$value": "#4E625B"
      },
      "border": {
        "$type": "color",
        "$value": "#C6D4CC"
      },
      "primary": {
        "$type": "color",
        "$value": "#007A8C"
      },
      "warning": {
        "$type": "color",
        "$value": "#B76B00"
      },
      "success": {
        "$type": "color",
        "$value": "#176B46"
      },
      "danger": {
        "$type": "color",
        "$value": "#A9282F"
      }
    },
    "dark": {
      "background": {
        "$type": "color",
        "$value": "#07100E"
      },
      "surface": {
        "$type": "color",
        "$value": "#0E1816"
      },
      "surfaceRaised": {
        "$type": "color",
        "$value": "#172620"
      },
      "text": {
        "$type": "color",
        "$value": "#EAF3EE"
      },
      "muted": {
        "$type": "color",
        "$value": "#A8BBB2"
      },
      "border": {
        "$type": "color",
        "$value": "#2E433B"
      },
      "primary": {
        "$type": "color",
        "$value": "#66E2F2"
      },
      "warning": {
        "$type": "color",
        "$value": "#FFC857"
      },
      "success": {
        "$type": "color",
        "$value": "#72E59A"
      },
      "danger": {
        "$type": "color",
        "$value": "#FF7A84"
      }
    },
    "highContrast": {
      "background": {
        "$type": "color",
        "$value": "#000000"
      },
      "surface": {
        "$type": "color",
        "$value": "#000000"
      },
      "text": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "border": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "primary": {
        "$type": "color",
        "$value": "#00E5FF"
      },
      "warning": {
        "$type": "color",
        "$value": "#FFFF00"
      },
      "success": {
        "$type": "color",
        "$value": "#00FF66"
      },
      "danger": {
        "$type": "color",
        "$value": "#FF5A5F"
      },
      "focus": {
        "$type": "color",
        "$value": "#FFFF00"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Atkinson Hyperlegible",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Atkinson Hyperlegible",
        "fontSize": "clamp(2.25rem, 4vw, 4rem)",
        "fontWeight": "700",
        "lineHeight": "0.98",
        "letterSpacing": "-0.03em"
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Atkinson Hyperlegible",
        "fontSize": "clamp(1.5rem, 2.6vw, 2.5rem)",
        "fontWeight": "700",
        "lineHeight": "1.08",
        "letterSpacing": "-0.02em"
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Atkinson Hyperlegible",
        "fontSize": "1.125rem",
        "fontWeight": "700",
        "lineHeight": "1.25"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Atkinson Hyperlegible",
        "fontSize": "1rem",
        "fontWeight": "400",
        "lineHeight": "1.55"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Atkinson Hyperlegible",
        "fontSize": "0.8125rem",
        "fontWeight": "700",
        "lineHeight": "1.2",
        "letterSpacing": "0.04em"
      }
    },
    "hudTitle": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Atkinson Hyperlegible",
        "fontSize": "1.375rem",
        "fontWeight": "700",
        "lineHeight": "1.08"
      }
    },
    "hudBody": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Atkinson Hyperlegible",
        "fontSize": "1.25rem",
        "fontWeight": "400",
        "lineHeight": "1.25"
      }
    },
    "overlayLabel": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Atkinson Hyperlegible",
        "fontSize": "1.5rem",
        "fontWeight": "700",
        "lineHeight": "1.15"
      }
    }
  },
  "spacing": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "10": {
      "$type": "dimension",
      "$value": "40px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "xs": {
      "$type": "dimension",
      "$value": "6px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "10px"
    },
    "md": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "32px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "elevation": {
    "panelRest": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(19,32,27,.08), 0 10px 30px rgba(19,32,27,.08)"
    },
    "panelLift": {
      "$type": "shadow",
      "$value": "0 10px 20px rgba(19,32,27,.10), 0 24px 60px rgba(19,32,27,.12)"
    },
    "hud": {
      "$type": "shadow",
      "$value": "0 18px 60px rgba(0,0,0,.34)"
    }
  },
  "motion": {
    "easeCue": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ]
    },
    "fast": {
      "$type": "duration",
      "$value": "180ms"
    },
    "dwell": {
      "$type": "duration",
      "$value": "500ms"
    },
    "selectionWindow": {
      "$type": "duration",
      "$value": "4000ms"
    },
    "reduceMotion": {
      "$type": "duration",
      "$value": "1ms",
      "$description": "Replace continuous rings/trails with static progress labels and bars."
    }
  },
  "asset": {
    "font": {
      "atkinsonHyperlegible": {
        "$type": "asset",
        "$value": "design/fonts/AtkinsonHyperlegible-Regular.ttf",
        "license": "OFL-1.1"
      }
    },
    "glyphs": {
      "$type": "asset",
      "$value": "design/glyphs/"
    },
    "domainIcons": {
      "$type": "asset",
      "$value": "design/icons/"
    }
  }
}
