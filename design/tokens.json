{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Flick Liquid Command Remote",
  "color": {
    "dark": {
      "background": {
        "$type": "color",
        "$value": "#090B10"
      },
      "surface": {
        "$type": "color",
        "$value": "#11141C"
      },
      "glass": {
        "$type": "color",
        "$value": "rgba(22, 25, 34, 0.62)"
      },
      "glassStrong": {
        "$type": "color",
        "$value": "rgba(26, 30, 42, 0.78)"
      },
      "text": {
        "$type": "color",
        "$value": "#F6F8FF"
      },
      "muted": {
        "$type": "color",
        "$value": "#AEB7CA"
      },
      "border": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.14)"
      }
    },
    "light": {
      "background": {
        "$type": "color",
        "$value": "#F5F7FB"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "glass": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.68)"
      },
      "glassStrong": {
        "$type": "color",
        "$value": "rgba(255,255,255,0.86)"
      },
      "text": {
        "$type": "color",
        "$value": "#10131A"
      },
      "muted": {
        "$type": "color",
        "$value": "#5B6475"
      },
      "border": {
        "$type": "color",
        "$value": "rgba(17,24,39,0.12)"
      }
    },
    "accent": {
      "blue": {
        "$type": "color",
        "$value": "#006DFF"
      },
      "violet": {
        "$type": "color",
        "$value": "#6D5DF7"
      },
      "mint": {
        "$type": "color",
        "$value": "#4EE6B8"
      },
      "amber": {
        "$type": "color",
        "$value": "#FFB84D"
      },
      "red": {
        "$type": "color",
        "$value": "#FF5D6C"
      }
    },
    "highContrast": {
      "background": {
        "$type": "color",
        "$value": "#000000"
      },
      "text": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "focus": {
        "$type": "color",
        "$value": "#FFFF00"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "system-ui",
          "-apple-system",
          "BlinkMacSystemFont",
          "Inter",
          "Segoe UI",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SF Mono",
          "Geist Mono",
          "Cascadia Mono",
          "monospace"
        ]
      },
      "hyperlegible": {
        "$type": "fontFamily",
        "$value": [
          "Atkinson Hyperlegible",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": "clamp(2.5rem, 5vw, 4.75rem)",
        "fontWeight": "700",
        "lineHeight": "0.94",
        "letterSpacing": "-0.06em"
      }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": "clamp(1.75rem, 3vw, 3rem)",
        "fontWeight": "700",
        "lineHeight": "1",
        "letterSpacing": "-0.045em"
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": "1.125rem",
        "fontWeight": "650",
        "lineHeight": "1.18",
        "letterSpacing": "-0.02em"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": "1rem",
        "fontWeight": "450",
        "lineHeight": "1.5"
      }
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": "0.875rem",
        "fontWeight": "500",
        "lineHeight": "1.35"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": "0.8125rem",
        "fontWeight": "650",
        "lineHeight": "1.2",
        "letterSpacing": "0.01em"
      }
    },
    "hudTitle": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": "1.375rem",
        "fontWeight": "700",
        "lineHeight": "1.08"
      }
    },
    "hudBody": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": "1.25rem",
        "fontWeight": "550",
        "lineHeight": "1.25"
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist Mono",
        "fontSize": "0.8125rem",
        "fontWeight": "550",
        "lineHeight": "1.3"
      }
    }
  },
  "spacing": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "10": {
      "$type": "dimension",
      "$value": "40px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    },
    "16": {
      "$type": "dimension",
      "$value": "64px"
    }
  },
  "radius": {
    "xs": {
      "$type": "dimension",
      "$value": "8px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "12px"
    },
    "md": {
      "$type": "dimension",
      "$value": "18px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "32px"
    },
    "xxl": {
      "$type": "dimension",
      "$value": "40px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "elevation": {
    "glassFloat": {
      "$type": "shadow",
      "$value": "0 24px 80px rgba(0,0,0,.34), inset 0 1px rgba(255,255,255,.18)"
    },
    "previewDepth": {
      "$type": "shadow",
      "$value": "0 32px 120px rgba(0,0,0,.38)"
    },
    "lightFloat": {
      "$type": "shadow",
      "$value": "0 24px 70px rgba(31,41,55,.16), inset 0 1px rgba(255,255,255,.82)"
    }
  },
  "material": {
    "glass": {
      "$type": "color",
      "$value": "var(--flick-material-glass)",
      "$description": "Blurred material with opaque fallback."
    },
    "glassStrong": {
      "$type": "color",
      "$value": "var(--flick-material-glass-strong)"
    },
    "opaqueFallback": {
      "$type": "color",
      "$value": "var(--flick-material-opaque)"
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "160ms"
    },
    "panel": {
      "$type": "duration",
      "$value": "220ms"
    },
    "dwell": {
      "$type": "duration",
      "$value": "500ms"
    },
    "selectionWindow": {
      "$type": "duration",
      "$value": "4000ms"
    },
    "reduceMotion": {
      "$type": "duration",
      "$value": "1ms"
    }
  },
  "asset": {
    "fontInter": {
      "$type": "asset",
      "$value": "design/fonts/Inter-Variable.ttf",
      "license": "OFL-1.1"
    },
    "fontGeistMono": {
      "$type": "asset",
      "$value": "design/fonts/GeistMono-Variable.ttf",
      "license": "OFL-1.1"
    },
    "fontHyperlegible": {
      "$type": "asset",
      "$value": "design/fonts/AtkinsonHyperlegible-Regular.ttf",
      "license": "OFL-1.1"
    },
    "glyphs": {
      "$type": "asset",
      "$value": "design/glyphs/"
    },
    "domainIcons": {
      "$type": "asset",
      "$value": "design/icons/"
    }
  }
}
