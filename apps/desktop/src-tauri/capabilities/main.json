{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main Flick webview permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }] },
    "notification:default",
    "main-commands"
  ]
}
