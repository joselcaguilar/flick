{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flick",
  "version": "0.1.0",
  "identifier": "app.flick.desktop",
  "build": {
    "beforeDevCommand": { "script": "pnpm run prepare-dev", "cwd": "..", "wait": false },
    "beforeBuildCommand": "pnpm run prepare-build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Flick",
        "url": "index.html",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "hud",
        "title": "Flick HUD",
        "url": "hud.html",
        "width": 360,
        "height": 96,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "resizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first hand gesture control for Home Assistant",
    "longDescription": "Flick turns camera hand gestures into local Home Assistant service calls.",
    "externalBin": ["binaries/flick-engine"],
    "resources": {
      "resources": ""
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": { "installerIcon": null }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["flick"], "name": "app.flick.desktop.flick", "role": "Viewer" }
    },
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_MINISIGN_PUBLIC_KEY",
      "endpoints": [
        "https://updates.flick.app/app/{{target}}/{{arch}}/{{current_version}}?channel=stable",
        "https://github.com/joselcaguilar/flick/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" },
      "requireSignedVersion": true
    }
  }
}
