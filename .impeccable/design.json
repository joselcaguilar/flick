      "css": ".ds-btn-primary{font-family:var(--font-sans);font-weight:700;letter-spacing:.04em;border:0;border-radius:999px;background:var(--flick-cue-cyan);color:var(--flick-primary-foreground);padding:12px 20px;min-height:44px;box-shadow:var(--flick-shadow-panel-rest);transition:transform var(--animate-cue-fast) var(--ease-cue),box-shadow var(--animate-cue-fast) var(--ease-cue)}.ds-btn-primary:hover{transform:translateY(-1px);box-shadow:var(--flick-shadow-panel-lift)}.ds-btn-primary:focus-visible{outline:3px solid var(--flick-focus);outline-offset:3px}.ds-btn-primary:active{transform:translateY(1px)}"
