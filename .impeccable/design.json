  "narrative": {
    "northStar": "Primer Operations Console",
    "overview": "Flick's shipped interface is a GitHub-grade operations console for the home. The chrome is calm, flat, and Primer-native; the live camera stage is the only area allowed to feel vivid because it is the evidence surface. The app refuses consumer smart-home tiles, decorative gradients, blur, and Liquid Glass.\n\nThe system is professional before it is expressive: Mona Sans, Monaspace Neon, GitHub's six selectable themes, opaque Boxes, divided lists, one action blue, and semantic status colors. Screens tell the same story every time: status at a glance, what Flick sees and did, then one primary action.",
    "keyCharacteristics": [
      "Mona Sans for interface text and Monaspace Neon for entity IDs, shortcuts, and diagnostics.",
      "Six GitHub themes selected by `data-theme`, with independent light/dark choices and system sync.",
      "1px borders, flat opaque fills, 6px controls, 12px Boxes, and no nested-card stacks.",
      "Accent-emphasis blue is the primary action color; semantic state colors are text-redundant.",
      "The camera preview stage stays dark in every theme so video and overlays read consistently."
    ],
    "rules": [
      {
        "name": "The Blue Is the Action Rule",
        "body": "Primary actions use `accent-emphasis`; do not switch primary buttons to success green or introduce a second brand accent.",
        "section": "colors"
      },
      {
        "name": "The Camera Owns Vividness Rule",
        "body": "Keep surrounding chrome quiet and tokenized; visual energy belongs to the live preview, state overlays, and semantic feedback.",
        "section": "colors"
      },
      {
        "name": "The Colorblind Semantics Rule",
        "body": "State must be carried by label, icon, and placement as well as color; colorblind themes deliberately remap success and danger.",
        "section": "colors"
      },
      {
        "name": "The Mona-First Rule",
        "body": "Mona Sans is the product voice; do not fall back to Inter, Geist, or decorative display fonts for new surfaces.",
        "section": "typography"
      },
      {
        "name": "The Mono Means Machine Rule",
        "body": "Monaspace Neon is reserved for values that behave like identifiers or shortcuts, never for headings or flavor.",
        "section": "typography"
      },
      {
        "name": "The Box-Then-Row Rule",
        "body": "Use one bordered Box with divided rows before creating new cards; nesting cards inside cards is off-world.",
        "section": "layout"
      },
      {
        "name": "The First Viewport Rule",
        "body": "Lead with status, then the live preview, then one primary action; do not open with marketing tiles or feature cards.",
        "section": "layout"
      },
      {
        "name": "The Flat Until Floating Rule",
        "body": "If a surface is part of the page, it is flat; if it floats above the page, it may use the overlay shadow.",
        "section": "elevation"
      },
      {
        "name": "The Six And Twelve Rule",
        "body": "Controls are 6px; Boxes are 12px. Do not bring back 24px+ liquid rounding.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do build new screens from Primer Boxes, divided rows, one primary action, and semantic status labels.",
      "Do consume `--flick-*` tokens so all six GitHub themes and system sync keep working.",
      "Do keep the camera stage dark across every theme.",
      "Do use accent-emphasis blue for primary actions and focus, not success green.",
      "Do pair status color with text, icon, tone, or placement for accessibility.",
      "Do preserve reduced-motion behavior by shortening animation to static state changes."
    ],
    "donts": [
      "Don't reintroduce Liquid Glass, backdrop blur, translucent panels, decorative gradients, or oversized rounded corners.",
      "Don't use consumer smart-home tiles, nested card decks, or marketing feature grids inside the app shell.",
      "Don't replace Mona Sans / Monaspace Neon with Inter, Geist, SF-only, or novelty fonts.",
      "Don't make ordinary page Boxes float with shadows; reserve overlay shadow for actual floating layers.",
      "Don't ban the room-sketch grid-line `linear-gradient`; it is a functional blueprint pattern, not decoration."
    ]
  }
}
