  "narrative": {
    "northStar": "Sightline Cue Desk",
    "overview": "Flick treats the room as a small stage: the camera is the booth, the user's pointing hand casts a sightline, and every gesture is a cue that must visibly lock, fire and resolve.",
    "keyCharacteristics": [
      "Sightlines and target rings are the signature visual primitives.",
      "Cyan means aiming/selection, amber waiting/attention, green done, red failed; text and icons always repeat state.",
      "Atkinson Hyperlegible is bundled for distance legibility.",
      "Surfaces are layered by tone, soft shadow and hairline grids, not decorative glass.",
      "Motion is a cue, not ornament."
    ],
    "rules": [
      {
        "name": "The Cue Rarity Rule",
        "body": "At rest, no more than one cue color family should dominate a view; color marks live state, not decoration.",
        "section": "colors"
      },
      {
        "name": "The Red Needs Words Rule",
        "body": "Any failed/unsafe state must include an icon plus a plain-language reason.",
        "section": "colors"
      },
      {
        "name": "The Three-Meter Rule",
        "body": "HUD primary text is never below 20 px; high-contrast HUD text uses black/white pairs that exceed 7:1.",
        "section": "typography"
      },
      {
        "name": "The Useful Blur Rule",
        "body": "Backdrop blur appears only behind the HUD or overlays on video/wallpaper, and must preserve contrast in high-contrast mode by switching to an opaque background.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do make the live preview or HUD state immediately answer: what Flick sees, what it selected, what happened.",
      "Do keep HUD text at 20 px or larger and repeat state with icons/text.",
      "Do use local bundled fonts and SVG assets; the app must work offline."
    ],
    "donts": [
      "Don't ship the stock shadcn theme, default gray palette or generic rounded card grid.",
      "Don't convey selected/done/failed by color alone.",
      "Don't load fonts, icons or images from a runtime CDN."
    ]
  }
