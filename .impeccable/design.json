      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:32px;border:1px solid transparent;border-radius:6px;background:var(--flick-accent-emphasis);color:var(--flick-on-accent);padding:0 12px;font-family:var(--font-sans);font-size:14px;font-weight:500;line-height:1;box-shadow:var(--flick-shadow-small);cursor:pointer;transition:background 120ms cubic-bezier(.2,0,0,1),border-color 120ms cubic-bezier(.2,0,0,1)}.ds-btn-primary:hover,.ds-btn-primary:active{background:color-mix(in srgb,var(--flick-accent-emphasis) 88%,var(--flick-text));color:var(--flick-on-accent)}.ds-btn-primary:focus-visible{outline:2px solid var(--flick-focus);outline-offset:2px}"
